# ============================================
# RAG Chatbot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- LLM Provider (chọn 1 trong 2: "openai" hoặc "gemini") ---
# Cả 2 provider đều đã verify hoạt động (gemini qua Interactions API, google-genai 2.x)
LLM_PROVIDER=openai

# --- Option 1: OpenAI / NVIDIA NIM ---
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL_ID=gpt-4o-mini
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1  # Bỏ comment nếu dùng NVIDIA NIM

# --- Option 2: Google Gemini ---
GEMINI_API_KEY=AIza-xxx
GEMINI_MODEL_ID=gemini-2.5-flash

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Ingestion namespace ---
# Hai source directory khác nhau không được dùng cùng ID nếu muốn sync độc lập.
INGEST_DATASET_ID=sample_docs
INGEST_VERSIONED=true
INGEST_MANIFEST_PATH=data/ingest_runs/manifest.sqlite3
INGEST_PIPELINE_VERSION=11.0
INGEST_SCHEMA_VERSION=1
INGEST_PARSER_VERSION=2
INGEST_CHUNKER_VERSION=2
# Pin to an immutable model revision for production backfills.
INGEST_EMBEDDING_MODEL_REVISION=
INGEST_EMBED_BATCH_SIZE=32
INGEST_DOCUMENT_WINDOW=8
INGEST_QDRANT_WRITE_BATCH_SIZE=256
INGEST_QDRANT_WRITE_MAX_BYTES=4000000
INGEST_QDRANT_MAX_RETRIES=5
INGEST_RETRY_BASE_SECONDS=0.25
INGEST_RETRY_MAX_SECONDS=8
INGEST_GENERATION_RETENTION=2
INGEST_MAX_MEMORY_MB=2048
INGEST_FAIL_ON_QUALITY=true

# --- Embedding Model (chạy local, không tốn tiền) ---
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_SIZE=384
EMBEDDING_DEVICE=cpu              # cpu | cuda | mps

# --- Reranker Model (chạy local) ---
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=30
RERANK_BATCH_SIZE=16

# --- RAG Parameters ---
TOP_K=20
KEEP_TOP_K=5
EXPAND_N_QUERY=3
MAX_CONTEXT_CHARS=24000
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200

# --- API ---
API_KEY=                          # để trống = tắt auth (dev)
