# ============================================
# RAG Chatbot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- LLM Provider (chọn 1 trong 2: "openai" hoặc "gemini") ---
# Cả 2 provider đều đã verify hoạt động (gemini qua Interactions API, google-genai 2.x)
LLM_PROVIDER=openai

# --- Option 1: OpenAI / NVIDIA NIM ---
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL_ID=gpt-4o-mini
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1  # Bỏ comment nếu dùng NVIDIA NIM

# --- Option 2: Google Gemini ---
GEMINI_API_KEY=AIza-xxx
GEMINI_MODEL_ID=gemini-2.5-flash

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Ingestion namespace ---
# Hai source directory khác nhau không được dùng cùng ID nếu muốn sync độc lập.
INGEST_DATASET_ID=kiemhiep_kimdung
INGEST_VERSIONED=true
INGEST_MANIFEST_PATH=data/ingest_runs/manifest.sqlite3
INGEST_PIPELINE_VERSION=14.0
INGEST_SCHEMA_VERSION=3
INGEST_PARSER_VERSION=2
INGEST_CHUNKER_VERSION=2
# Pin to an immutable model revision for production backfills.
INGEST_EMBEDDING_MODEL_REVISION=
INGEST_EMBED_BATCH_SIZE=32
INGEST_DOCUMENT_WINDOW=8
INGEST_QDRANT_WRITE_BATCH_SIZE=256
INGEST_QDRANT_WRITE_MAX_BYTES=4000000
INGEST_QDRANT_MAX_RETRIES=5
INGEST_RETRY_BASE_SECONDS=0.25
INGEST_RETRY_MAX_SECONDS=8
INGEST_GENERATION_RETENTION=2
INGEST_MAX_MEMORY_MB=2048
# PDF parser windows keep one large PDF bounded; operators provide one source
# file and do not need to split it manually.
INGEST_PDF_PAGE_WINDOW=16
INGEST_PDF_OCR_PAGE_WINDOW=4
INGEST_PDF_OCR_MODE=missing_pages
INGEST_PDF_MAX_PAGES=5000
INGEST_PDF_SPOOL_MAX_MB=64
INGEST_PDF_WINDOW_TIMEOUT_SECONDS=300
INGEST_FAIL_ON_QUALITY=true

# --- Native Qdrant BM25 / server-side hybrid retrieval ---
QDRANT_SPARSE_VECTOR_NAME=bm25
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_SPARSE_TOKENIZER=multilingual
QDRANT_SPARSE_LANGUAGE=none
QDRANT_SPARSE_K=1.2
QDRANT_SPARSE_B=0.75
QDRANT_SPARSE_AVG_LEN=256
QDRANT_SPARSE_ON_DISK=true
QDRANT_HYBRID_PREFETCH_LIMIT=40

# --- Vietnamese/English embedding model ---
# BGE-M3 outputs 1024 dimensions.  Production normally points at a pinned
# self-hosted GPU service; local mode is useful for development only.
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=
EMBEDDING_SIZE=1024
EMBEDDING_DEVICE=cuda             # cpu | cuda | mps (local mode)
EMBEDDING_RUNTIME=remote          # remote (production) | local (dev)
EMBEDDING_BASE_URL=http://embedding-gpu:8080
EMBEDDING_HTTP_TIMEOUT_SECONDS=30
EMBEDDING_NORMALIZE=true

# --- Vietnamese/English reranker ---
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=
RERANK_CANDIDATES=30
RERANK_BATCH_SIZE=16
RERANKER_DEVICE=cuda             # local mode; remote mode ignores this
RERANKER_RUNTIME=remote         # remote (production) | local (dev)
RERANKER_BASE_URL=http://reranker-gpu:8080
RERANKER_HTTP_TIMEOUT_SECONDS=30

# --- PR17: self-hosted Apple Silicon model server ---
# Run `make run-model-server MODEL_SERVER_DEVICE=mps` in a separate process.
# Keep workers=1: requests are concurrent, but one shared MPS arbiter and the
# dynamic batchers bound unified-memory pressure.  Set ENABLED=true in the
# API/worker environment only when /ready + /metadata should be a hard gate.
MODEL_SERVER_ENABLED=false
MODEL_SERVER_HOST=127.0.0.1
MODEL_SERVER_PORT=8082
MODEL_SERVER_DEVICE=cpu       # cpu | mps
MODEL_SERVER_WORKERS=1
MODEL_SERVER_API_KEY=
MODEL_SERVER_MAX_BODY_BYTES=4000000
MODEL_SERVER_MAX_PENDING_REQUESTS=128
MODEL_SERVER_MAX_PENDING_ITEMS=4096
MODEL_SERVER_MAX_PENDING_BYTES=32000000
MODEL_SERVER_QUEUE_TIMEOUT_SECONDS=30
MODEL_SERVER_BATCH_WAIT_MS=8
MODEL_SERVER_MPS_MAX_INFLIGHT_BATCHES=1
MODEL_SERVER_ONLINE_MAX_BURST_BATCHES=8
MODEL_SERVER_MAX_ITEMS_PER_REQUEST_PER_BATCH=16
MODEL_SERVER_SHUTDOWN_GRACE_SECONDS=30
MODEL_SERVER_ALLOW_CPU_FALLBACK=false
EMBEDDING_MAX_INPUT_TOKENS=1024
EMBEDDING_DYNAMIC_BATCH_MAX_ITEMS=64
EMBEDDING_DYNAMIC_BATCH_MAX_TOKENS=8192
RERANKER_MAX_INPUT_TOKENS=512
RERANKER_DYNAMIC_BATCH_MAX_ITEMS=32
RERANKER_DYNAMIC_BATCH_MAX_TOKENS=8192

# --- RAG Parameters ---
TOP_K=20
KEEP_TOP_K=5
EXPAND_N_QUERY=3
MAX_CONTEXT_CHARS=24000

# --- Redis admission queue + provider quota ---
# API processes enqueue only.  A worker reserves provider-call capacity before
# entering embedding/search/reranking/LLM.  Use inline only for local tests.
APP_ENV=development
RAG_EXECUTION_MODE=inline       # redis_worker in production
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=rag:default
REDIS_QUEUE_STREAM=rag:default:jobs
REDIS_QUEUE_GROUP=rag-workers
REDIS_OUTSTANDING_KEY=rag:default:outstanding
REDIS_RATE_SCHEDULE_KEY=rag:default:llm_schedule
REDIS_RATE_RESERVATION_PREFIX=rag:default:reservation:
REDIS_JOB_PREFIX=rag:default:job:
REDIS_IDEMPOTENCY_PREFIX=rag:default:idempotency:
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_RESULT_POLL_SECONDS=0.1
RAG_QUEUE_MAX_OUTSTANDING=32
RAG_JOB_MAX_WAIT_SECONDS=180
RAG_JOB_TTL_SECONDS=600
RAG_WORKER_CONCURRENCY=2
RAG_WORKER_LEASE_SECONDS=300
RAG_WORKER_HEARTBEAT_TTL_SECONDS=10
LLM_RATE_LIMIT_CALLS=15
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_RESERVATION_TTL_SECONDS=600
LLM_HTTP_TIMEOUT_SECONDS=60
QDRANT_QUERY_TIMEOUT_SECONDS=8
SSE_SEND_TIMEOUT_SECONDS=15
# This is only an output cap; PR14 deliberately does not do input token
# accounting in the context assembler.
LLM_MAX_OUTPUT_TOKENS=1024
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200

# --- API ---
API_KEY=                          # backend key; để trống chỉ trong dev inline

# --- Thin UI qua FastAPI (PR15) ---
# UI không gọi trực tiếp retriever, Qdrant hoặc Redis.
UI_DEMO_MODE=dev                  # dev | product
UI_API_BASE_URL=http://127.0.0.1:8080
UI_HOST=127.0.0.1
UI_PORT=7860
UI_CONNECT_TIMEOUT_SECONDS=3
UI_REQUEST_TIMEOUT_SECONDS=90
UI_SSE_IDLE_TIMEOUT_SECONDS=45
UI_MAX_INPUT_CHARS=2000
UI_HISTORY_MAX_TURNS=3
# Server-side service key, thường đặt bằng giá trị API_KEY trong demo product.
UI_API_KEY=
# Chỉ cần cho internal demo; không dùng thay user identity/ACL.
UI_AUTH_USERNAME=
UI_AUTH_PASSWORD=
UI_PUBLIC_SHARE=false             # true chỉ khi đã đặt username/password

# --- Per-job Redis token event streams ---
REDIS_JOB_EVENT_PREFIX=rag:default:events:
REDIS_JOB_EVENT_TTL_SECONDS=300
