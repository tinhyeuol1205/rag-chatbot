# ML Models (download tự động, không cần push)
# ============================================
*.pt
*.bin
*.safetensors
models/

# ============================================
# Qdrant Data (Docker volume)
# ============================================
qdrant_storage/

# ============================================
# Misc
# ============================================
*.log
.coverage
htmlcov/
.pytest_cache/

# ============================================
# Review (chứa các file review, không cần push)
# ============================================
review/

# ============================================
# Data (chứa các file dữ liệu, không cần push)
# ============================================
data/*
# Evaluation suite contracts are versioned; run artifacts remain ignored.
!data/eval/
!data/eval/suites/
!data/eval/suites/*.json

# Local manifests and dry-run output
tmp/
temp/

# Local benchmark reports (may contain deployment timing metadata)
artifacts/rag-latency*.json
